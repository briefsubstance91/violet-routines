# Violet's app — environment. Copy to .env for local runs; set the same keys in
# Railway for the deploy. Everything here has a working default except the
# parent API token, so the app still runs with an empty file.

# Where runtime data (logs, earnings, edited CSVs) is written. Railway mounts a
# volume here; locally it falls back to the repo folder.
DATA_DIR=

# Signs the parent's login cookie. Unset = a key is generated and remembered on
# the volume, which is fine — set it if you want logins to survive a volume wipe.
SECRET_KEY=

# The parent PIN for this app's own /admin pages. A PIN saved in-app overrides
# this. Default is 1234, so set it before the app is on the open internet.
ADMIN_PIN=

# Shared secret for the parent API (/api/parent/*), which is how the Life OS
# parent console reads and writes this app's data. Must match VIOLET_PARENT_TOKEN
# in Life OS. Unset = the parent API is off (401 on every call), not open.
PARENT_API_TOKEN=
